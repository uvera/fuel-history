# Example oneshot systemd service that runs Laravel's scheduler. Paired with
# fuel-history-schedule.timer.example, which fires this every minute --
# Laravel's own Schedule:: definitions in routes/console.php decide what
# actually runs and when (see `backup:run`/`backup:clean`/`backup:monitor`).
# Adjust paths and the user to match how the app was actually provisioned on
# the host, and drop both files in /etc/systemd/system/.

[Unit]
Description=Fuel History scheduler tick
After=network.target postgresql.service

[Service]
Type=oneshot
User=fuel-history
Group=fuel-history
WorkingDirectory=/opt/fuel-history
ExecStart=/usr/bin/php artisan schedule:run
